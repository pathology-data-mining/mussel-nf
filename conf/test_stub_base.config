// Shared settings for all stub test profiles.
// Include at the start of each stub profile block, then add profile-specific overrides.
params {
    samples_csv           = "${projectDir}/tests/test.csv"
    use_one_step_workflow = true

    tiling {
        filter_tiles     = false
        seg_config_group = 'biopsy'
        patch_size       = 224
        mpp              = 0.5
    }

    featurize {
        model_types         = ['resnet50']
        use_gpu             = false
        save_features_to_h5 = true
        batch_size          = 64
        workflow_batch_size = 1
        slide_batch_size    = 1
    }

    clip         { model_types = [] }
    wds          { enabled = false }
    linear_probe { annotations_csv = null }
}

process {
    executor = 'local'
    // No beforeScript: stub blocks don't invoke any mussel CLI tools.
    withLabel: parallelTask { cpus   = 1 }
    withLabel: bigTask      { memory = 2.GB }
    withLabel: hugeTask     { memory = 2.GB }
    withLabel: cpuTask      { memory = 2.GB }
}
