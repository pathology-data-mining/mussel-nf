// Minimal non-stub configuration for executing FEATURIZE_BATCH's script block
// with the repository's fake extract_features command.
params {
    outdir = "${projectDir}/results_real_featurize"
    publish_mode = 'copy'

    featurize {
        model_types                 = ['optimus']
        model_paths                 = [:]
        slide_model_paths           = [:]
        slide_to_patch_mapping      = [:]
        model_batch_sizes           = [:]
        model_precision_overrides   = [:]
        embedding_precision         = 'float32'
        batch_size                  = 64
        slide_batch_size            = 1
        slide_max_patches           = 0
        use_gpu                     = false
    }

    clip { model_types = [] }
}

env.PATH = "${projectDir}/fixtures/bin:${System.getenv('PATH')}"

process {
    executor = 'local'
    conda = null
    container = null
}
