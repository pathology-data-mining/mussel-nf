nextflow_pipeline {
    name   "MUSSEL pipeline — WebDataset grouped sharding (oncotree)"
    script "../main.nf"
    profile "test_wds_grouped"

    test("WDS grouped sharding creates per-oncotree *.tar") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success

            def shardDir = new File("${outputDir}/wds/resnet50/BRCA")
            assert shardDir.isDirectory() : "Shard directory missing: ${shardDir}"

            def tars = shardDir.listFiles().findAll { it.name.endsWith('.tar') }
            assert tars.size() > 0 : "No *.tar files in ${shardDir}"

            tars.each { tar ->
                def proc = ['tar', 'tf', tar.absolutePath].execute()
                proc.waitFor()
                assert proc.exitValue() == 0 : "tar tf failed for ${tar.name}"
                assert proc.text.trim().split('\n').any { it.endsWith('.features.npy') } :
                    "No .features.npy entries found in ${tar.name}"
            }
        }
    }
}
