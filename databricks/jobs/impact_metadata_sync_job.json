{
  "name": "impact-metadata-sync",
  "description": "Merge IMPACT slide inventory + feature extraction status Parquet into the your_catalog.your_schema.impact_slide_embeddings Delta table. Triggered by mussel_dispatcher.impact.sync_databricks after each dispatcher batch.",
  "job_clusters": [
    {
      "job_cluster_key": "metadata_sync_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.master": "local[*]"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "merge_metadata",
      "description": "Read latest Parquet from UC volume and MERGE INTO Delta table",
      "notebook_task": {
        "notebook_path": "/Users/your-user@your-org.com/mussel-nf/notebooks/metadata_sync",
        "base_parameters": {
          "volume_folder": "/Volumes/your_catalog/your_schema/impact_dispatcher",
          "target_table": "your_catalog.your_schema.impact_slide_embeddings",
          "merge_key": "slide_id",
          "filename_prefix": "impact_inventory_"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "metadata_sync_cluster",
      "timeout_seconds": 1800,
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "tags": {
    "project": "impact-feature-extraction",
    "team": "pathology-data-mining"
  }
}
