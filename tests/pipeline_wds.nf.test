nextflow_pipeline {
    name   "MUSSEL pipeline — WebDataset flat sharding"
    script "../main.nf"
    profile "test_wds"

    test("WDS sharding packs features into shard-*.tar (group=all)") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success

            def shardDir = new File("${outputDir}/wds/resnet50/all")
            assert shardDir.isDirectory() : "Shard directory missing: ${shardDir}"

            def tars = shardDir.listFiles().findAll { it.name.endsWith('.tar') }
            assert tars.size() > 0 : "No shard-*.tar files in ${shardDir}"

            tars.each { tar ->
                def proc = ['tar', 'tf', tar.absolutePath].execute()
                proc.waitFor()
                assert proc.exitValue() == 0 : "tar tf failed for ${tar.name}"
                assert proc.text.trim().split('\n').any { it.endsWith('.pt') } :
                    "No .pt entries found in ${tar.name}"
            }
        }
    }
}
