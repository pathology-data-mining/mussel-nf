nextflow_pipeline {
    name   "MUSSEL one-step + WDS grouped by oncotree — stub mode"
    script "../main.nf"
    profile "test_stub_wds_grouped"
    options "-stub"

    // Exercises: TESSELLATE_FEATURIZE_BATCH → WDS_SHARD grouped by oncotree_code
    test("WDS grouped stub workflow succeeds and publishes a per-oncotree shard tar") {
        when {
            params { outdir = "${outputDir}" }
        }
        then {
            assert workflow.success
            assert path("${outputDir}/features/resnet50/948176.features.pt").exists()
            // Shard published under wds/{model_type}/{oncotree_code}/ (BRCA from test_oncotree.csv)
            assert path("${outputDir}/wds/resnet50/BRCA/000000.tar").exists()
        }
    }
}
