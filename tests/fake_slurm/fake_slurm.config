// Fast polling for runs against tests/fake_slurm (put that directory first on PATH).
executor {
  pollInterval      = '1s'
  queueStatInterval = '1s'
  dumpInterval      = '10s'
  retry {
    delay    = '100ms'
    maxDelay = '200ms'
  }
}

// One slide per TESSELLATE task, as the tests expect (task names like
// TESSELLATE_PATCHES:TESSELLATE (2), and several sample rows share one slide file,
// which a batched TESSELLATE_BATCH would stage twice under the same name).
params.tiling.workflow_batch_size = 1
