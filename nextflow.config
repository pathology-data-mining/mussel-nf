nextflow.enable.moduleBinaries = true

// process.conda = "/gpfs/mskmind_ess/limr/repos/Mussel-2/venv"
process.conda = "mussel_env.yaml"


params {
  // model_types = ['quiltnet']
  // clip_default_classes = ["invasive carcinoma", "stroma", "other"]

    dremio {
        hostname = 'tlvidreamcord1'
        port = 32010
        scheme = 'grpc+tcp'
        space = 'OCRA.archive'
        table = 'matched_QC_case_breakdown'
    }
}

aws {
    accessKey = secrets.LARGE_ACCESS_KEY
    secretKey = secrets.LARGE_SECRET_KEY
    client {
        endpoint = "https://pllimsksparky3:9006"
        s3PathStyleAccess = true
    }
}

azure {
    storage {
        accountName = "mskpdm"
        accountKey = secrets.AZURE_STORAGE_KEY
    }
    batch {
        location = 'eastus2'
        accountName = 'ocra'
        accountKey = secrets.AZURE_BATCH_KEY
        autoPoolMode = false
        allowPoolCreation = true
        deletePoolsOnCompletion = true
        pools {
            'gpu_v100' {
                autoScale = true
                vmType = 'Standard_NC6s_v3'
                offer = 'ubuntu-hpc'
                publisher = 'microsoft-dsvm'
                sku = "batch.node.ubuntu 22.04"
                vmCount = 5
                maxVmCount = 30
            }
            'cpu' {
                autoScale = true
                vmType = 'Standard_E8_v3'
                vmCount = 5
                maxVmCount = 50
            }
        }
    }
}
profiles {
    standard {
        memory = 36.GB

        process {
            executor = 'local'

            withLabel: parallelTask {
                cpus = 16
            }
        }
    }

    docker {
        docker.enabled = true
        process {
            container = "mskmind/mussel:current"
            containerOptions = "--user root"
        }
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        env.TORCH_HOME = "torch"
        process {
            container = "docker://mskmind/mussel:current"
            // container = '/gpfs/mskmind_ess/limr/repos/Mussel/mussel-current.sif'
            containerOptions = "--env PREPEND_PATH=/opt/conda/bin"
        }
    }

    conda {
        conda.enabled = true
    }

    cluster {
        process {
            executor = 'condor'
            withLabel: smallTask {
                memory = 12.GB
            }

            withLabel: bigTask {
                memory = 30.GB
            }

            withLabel: gpuTask {
                clusterOptions = "request_gpus=1"
            }

            withLabel: parallelTask {
                cpus = 16
            }

            withLabel: localTask {
                executor = 'local'
            }

        }
    }

    cloud {
      params {
        ctranspath.model_path = "/code/mussel/ctranspath_model.pt"
      }
        process {
            executor = 'azurebatch'
            containerOptions = "--user=root --ipc=host"

            memory = 16.GB

            withLabel: parallelTask {
                cpus = 6
            }
            withLabel: localTask {
                executor = 'local'
            }
            withLabel: gpuTask {
                queue = 'gpu_v100'
                cpus = 6
                memory = 100.GB
                time = '1h'
                errorStrategy = {
                  sleep(Math.pow(2, task.attempt) * 200 as long);
                  return task.attempt <= 3 ? 'retry' : 'ignore'
                }
            }
            withLabel: cpuTask {
                cpus = 8
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
                queue = 'cpu'
                memory = 1024.GB
            }
        }
    }
}

