nextflow.enable.moduleBinaries = true

// process.conda = "mussel_env.yaml" // not working
process.conda = "/gpfs/mskmind_ess/limr/repos/Mussel/venv"


validation {
  help {
    enabled = true
  }
}

params {
  // Workflow mode selection
  use_one_step_workflow = true  // Set to true to use TESSELLATE_FEATURIZE_BATCH (one-step), false for separate TESSELLATE + FEATURIZE_BATCH (two-step)

  tiling {
    filter_model_type = 'ctranspath'
    filter_model_path = "/gpfs/mskmind_ess/limr/repos/Mussel/model-1727990346535.pkl"
    filter_threshold = 0.75
    filter_tiles = true

    // Segmentation config group: 'default', 'biopsy', 'resection', or 'tcga'
    // See mussel/cli/tessellate.py for preset configurations
    // If null, uses individual parameters below
    seg_config_group = 'biopsy'  // e.g., 'biopsy', 'resection', 'tcga'

    // Individual segmentation parameters (used when seg_config_group is null, or to override group defaults)
    patch_size = 224
    mpp = 0.5
    // segment_threshold = 15
    // median_blur_ksize = 11
    // morphology_ex_kernel = 2
    // tissue_area_threshold = 1
    // hole_area_threshold = 1
    // max_num_holes = 2

    save_slide_thumbnail = false
    save_tile_png = false
    stitch_tiles = false
  }

  featurize {
    // Supported model types (patch-level and slide-level encoders):
    // Patch encoders: 'resnet50', 'ctranspath', 'gigapath', 'virchow', 'virchow2',
    //                 'optimus', 'uni', 'uni2h', 'conch1_5', 'clip', 'googlepath'
    // Slide encoders: 'gigapath_slide', 'titan_slide'
    //
    // Note: Slide encoders can be specified directly in model_types.
    // The pipeline will automatically infer and use the required patch encoder.
    // For example, specifying 'gigapath_slide' will automatically use 'gigapath'
    // for patch encoding and then aggregate with 'gigapath_slide'.
    // Both patch and slide features will be saved separately.
    model_types = ['optimus']

    use_gpu = true
    save_features_to_h5 = true

    // ============================================================================
    // BATCHING CONFIGURATION
    // ============================================================================
    // There are three types of batching that occur during feature extraction:
    //
    // 1. TILE BATCHING (batch_size):
    //    Number of tiles processed together by the patch/tile encoder in a single forward pass.
    //    This is the batch size for the patch-level model (e.g., gigapath, optimus, ctranspath).
    //    Higher values = faster processing but more GPU memory usage.
    //    Default: 64
    //
    // 2. WORKFLOW BATCHING (workflow_batch_size):
    //    Number of SLIDES grouped together in a single Nextflow task for processing.
    //    All tiles from these slides are extracted in one job. This reduces Nextflow
    //    scheduling overhead and allows efficient parallel processing.
    //    Default: 8
    //
    // 3. SLIDE ENCODER BATCHING (slide_batch_size):
    //    When using slide-level models (e.g., gigapath_slide, titan_slide), this determines
    //    how many slide-level feature aggregations are computed together in a single batch.
    //    Only used when model_types includes slide encoders.
    //    Default: 8
    //
    // Recommended settings:
    // - Small GPU (16GB): batch_size=32, workflow_batch_size=4, slide_batch_size=4
    // - Medium GPU (24GB): batch_size=64, workflow_batch_size=8, slide_batch_size=8
    // - Large GPU (40GB+): batch_size=128, workflow_batch_size=16, slide_batch_size=16
    //
    batch_size = 64              // Tile batching: number of tiles per forward pass
    workflow_batch_size = 8      // Workflow batching: number of slides per Nextflow task
    slide_batch_size = 8         // Slide encoder batching: number of slides aggregated together

    // Optional: Specify local paths for models (default: download from HuggingFace Hub)
    // Only needed if you want to use locally cached models instead of downloading
    model_paths {
        ctranspath = "/gpfs/mskmind_ess/limr/repos/TransPath/ctranspath.pth"
        // optimus = "/gpfs/mskmind_ess/limr/repos/mussel-nf/optimus.pkl"
        resnet50 = "/gpfs/mskmind_ess/limr/repos/Mussel/resnet50.pkl"
        gigapath = "/gpfs/cdsi_ess/kohlia/codebase/models/gigapath_model.pkl"
    }

    // Optional: Configure per-model batch sizes
    // If not specified, uses the default batch_size above
    // model_batch_sizes {
    //     ctranspath = 32
    //     optimus = 64
    //     virchow2 = 256
    // }

    // Optional: Specify local paths for slide-level models
    // Only needed if you want to use locally cached slide models
    // slide_model_paths {
    //     gigapath_slide = "/path/to/gigapath_slide_model"
    //     titan_slide = "/path/to/titan_slide_model"
    // }

    // Mapping from slide encoders to their required patch encoders
    // This is automatically applied when using slide encoders in model_types
    // See mussel/models/model_factory.py SLIDE_ENCODER_COMPATIBILITY for the source
    slide_to_patch_mapping {
        gigapath_slide = 'gigapath'
        titan_slide = 'conch1_5'
    }
  }

  clip {
    model_types = ['quiltnet']
    default_classes = ["invasive carcinoma", "stroma", "other"]
    oncotree_class_csv = null
    skip_tile_caching = true
  }

  linear_probe {
    annotation_class_mapping_yaml = null
    annotations_csv = null
  }

  workflow_id = "reef"

  outdir = "results"
  publish_mode = "copy"
  samples_csv = null

  samples_csv_watch_path = null
  watch_path = null


  publish_slide_prefix = true
}

aws {
    accessKey = secrets.ECS_ACCESS_KEY
    secretKey = secrets.ECS_SECRET_KEY
    client {
      maxConnections = 20
        endpoint = "http://pmindecs.mskcc.org:9020"
        s3PathStyleAccess = true
    }
}

azure {
    storage {
        accountName = "mskpdm"
        accountKey = secrets.AZURE_STORAGE_KEY
    }
    batch {
        location = 'eastus2'
        accountName = 'ocra'
        accountKey = secrets.AZURE_BATCH_KEY
        autoPoolMode = false
        allowPoolCreation = true
        deletePoolsOnCompletion = true
        pools {
            'gpu_v100' {
                autoScale = true
                vmType = 'Standard_NC6s_v3'
                offer = 'ubuntu-hpc'
                publisher = 'microsoft-dsvm'
                sku = "batch.node.ubuntu 22.04"
                vmCount = 5
                maxVmCount = 30
            }
            'cpu' {
                autoScale = true
                vmType = 'Standard_E8_v3'
                vmCount = 5
                maxVmCount = 50
            }
        }
    }
}
profiles {
    standard {
        memory = 36.GB

        process {
            executor = 'local'

            withLabel: parallelTask {
                cpus = 8
            }
        }
    }

    docker {
        docker.enabled = true
        params {
            tiling.filter_model_path = "/code/mussel/model-1727990346535.pkl"
        }
        process {
            container = "mskmind/mussel:current"
            containerOptions = "--user root"
        }
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        env.TORCH_HOME = "torch"
        process {
            container = "docker://mskmind/mussel:current"
            // container = '/gpfs/mskmind_ess/limr/repos/Mussel/mussel-current.sif'
            containerOptions = "--env PREPEND_PATH=/opt/conda/bin"
        }
    }

    conda {
        conda.enabled = true
    }

    cluster {
    executor {
      queueSize = 500
    }
      process {
        errorStrategy = 'ignore'
        // errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
            withLabel: smallTask {
                memory = 12.GB
            }

            withLabel: bigTask {
                memory = 30.GB
            }

            withLabel: hugeTask {
                memory = 1024.GB
            }

            withLabel: parallelTask {
                cpus = 8
            }

            withLabel: localTask {
                executor = 'local'
            }

        }
    }

    condor {
        process {
            executor = 'condor'

            withLabel: gpuTask {
                clusterOptions = "request_gpus=1"
            }

        }
    }

    slurm {
        process {
            executor = 'slurm'
            withLabel: gpuTask {
                clusterOptions = "--gpus=1"

            }

        }
    }


    cloud {
        process {
            executor = 'azurebatch'
            containerOptions = "--user=root --ipc=host"

            memory = 16.GB

            withLabel: localTask {
                executor = 'local'
            }
            withLabel: gpuTask {
                queue = 'gpu_v100'
                cpus = 6
                memory = 100.GB
                time = '1h'
                errorStrategy = {
                  sleep(Math.pow(2, task.attempt) * 200 as long);
                  return task.attempt <= 3 ? 'retry' : 'ignore'
                }
            }
            withLabel: cpuTask {
                cpus = 8
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
                queue = 'cpu'
                memory = 1024.GB
            }
        }
    }
}

plugins {
  id 'nf-schema@2.2.0'
}
