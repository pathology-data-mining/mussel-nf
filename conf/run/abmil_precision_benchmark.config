// Run config for ABMIL precision benchmarking against existing reef-wds LUAD shards.
// Usage:
//   nextflow run main.nf -profile conda,cluster -c conf/run/abmil_precision_benchmark.config
//
// No slides need to be processed — shards are read directly from reef-wds.

params {
    outdir = "results/abmil_precision_benchmark"

    wds {
        existing_shard_dir  = "/open-mskmind_ess/reef-wds/LUAD"
        existing_group      = "LUAD"
        existing_model_type = "optimus_L"
    }

    abmil_benchmark {
        enabled        = true
        paladin_dir    = "/gpfs/mskmind_ess/limr/ess/repos/paladin"
        conda_env      = "/gpfs/mskmind_ess/limr/repos/paladin/venv"
        dataset_config = "clf_LUAD_Primary_STK11_ONCOGENIC"
        train_config   = "precision_benchmark"
        nn_config      = "jointbb"
        data_config    = "joint_optimus_wds"
        dtypes         = ["float32", "float16", "bfloat16"]
        seed           = 0
    }
}
