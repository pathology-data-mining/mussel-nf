nextflow_pipeline {
    name   "MUSSEL main pipeline — two-step workflow"
    script "../main.nf"
    profile "test_two_step"

    test("two-step workflow succeeds and produces features") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
            assert path("${outputDir}/features/resnet50/948176.features.pt").exists()
        }
    }
}
