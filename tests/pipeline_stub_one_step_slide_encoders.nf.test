nextflow_pipeline {
    name   "MUSSEL one-step pipeline — slide encoders at their own tiles (stub)"
    script "../main.nf"
    profile "test_stub_one_step_slide_encoders"
    options "-stub"

    test("chief_slide and titan_slide without overrides are not rejected") {
        when {
            params { outdir = "${outputDir}" }
        }
        then {
            assert workflow.success
            for (model in ['hoptimus1', 'chief_slide', 'titan_slide']) {
                assert path("${outputDir}/features/${model}/948176.features.pt").exists() : model
            }
        }
    }
}
