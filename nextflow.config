nextflow.enable.moduleBinaries = true

process.conda = "/gpfs/mskmind_ess/limr/repos/Mussel/venv"
// process.conda = "mussel_env.yaml"



validation {
  help {
    enabled = true
  }
}

params {
  tiling {
    filter_model_type = 'ctranspath'
    filter_threshold = 0.75
    filter_tiles = true

    patch_size = 224
    mpp = 0.5
    segment_threshold = 15
    median_blur_ksize = 11
    morphology_ex_kernel = 2
    tissue_area_threshold = 1
    hole_area_threshold = 1
    max_num_holes = 2

    save_slide_thumbnail = false
    save_tile_png = false
    stitch_tiles = false
  }

  featurize {
    model_types = ['optimus']
    use_gpu = true
  }

  clip {
    model_types = ['quiltnet']
    default_classes = ["invasive carcinoma", "stroma", "other"]
    oncotree_class_csv = null
    skip_tile_caching = true
  }

  linear_probe {
    annotation_class_mapping_yaml = null
    annotations_csv = null
  }

  workflow_id = "reef"

  outdir = "results"
  publish_mode = "copy"
  samples_csv = null

  samples_csv_watch_path = null
  watch_path = null


  publish_slide_prefix = true
}

aws {
    accessKey = secrets.LARGE_ACCESS_KEY
    secretKey = secrets.LARGE_SECRET_KEY
    client {
      maxConnections = 20
        endpoint = "https://pllimsksparky3:9006"
        s3PathStyleAccess = true
    }
}

azure {
    storage {
        accountName = "mskpdm"
        accountKey = secrets.AZURE_STORAGE_KEY
    }
    batch {
        location = 'eastus2'
        accountName = 'ocra'
        accountKey = secrets.AZURE_BATCH_KEY
        autoPoolMode = false
        allowPoolCreation = true
        deletePoolsOnCompletion = true
        pools {
            'gpu_v100' {
                autoScale = true
                vmType = 'Standard_NC6s_v3'
                offer = 'ubuntu-hpc'
                publisher = 'microsoft-dsvm'
                sku = "batch.node.ubuntu 22.04"
                vmCount = 5
                maxVmCount = 30
            }
            'cpu' {
                autoScale = true
                vmType = 'Standard_E8_v3'
                vmCount = 5
                maxVmCount = 50
            }
        }
    }
}
profiles {
    standard {
        memory = 36.GB

        process {
            executor = 'local'

            withLabel: parallelTask {
                cpus = 8
            }
        }
    }

    docker {
        docker.enabled = true
        process {
            container = "mskmind/mussel:current"
            containerOptions = "--user root"
        }
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        env.TORCH_HOME = "torch"
        process {
            container = "docker://mskmind/mussel:current"
            // container = '/gpfs/mskmind_ess/limr/repos/Mussel/mussel-current.sif'
            containerOptions = "--env PREPEND_PATH=/opt/conda/bin"
        }
    }

    conda {
        conda.enabled = true
    }

    cluster {
    executor {
      queueSize = 500
    }
      process {
        errorStrategy = 'ignore'
        // errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
            withLabel: smallTask {
                memory = 12.GB
            }

            withLabel: bigTask {
                memory = 30.GB
            }

            withLabel: hugeTask {
                memory = 1024.GB
            }

            withLabel: parallelTask {
                cpus = 8
            }

            withLabel: localTask {
                executor = 'local'
            }

        }
    }

    condor {
        process {
            executor = 'condor'

            withLabel: gpuTask {
                clusterOptions = "request_gpus=1"
            }

        }
    }

    slurm {
        process {
            executor = 'slurm'
            withLabel: gpuTask {
                clusterOptions = "--gpus=1"
            }

        }
    }


    cloud {
      params {
        ctranspath.model_path = "/code/mussel/ctranspath.pth"
        filter_model_path = "/code/mussel/model-1727990346535.pkl"
      }
        process {
            executor = 'azurebatch'
            containerOptions = "--user=root --ipc=host"

            memory = 16.GB

            withLabel: localTask {
                executor = 'local'
            }
            withLabel: gpuTask {
                queue = 'gpu_v100'
                cpus = 6
                memory = 100.GB
                time = '1h'
                errorStrategy = {
                  sleep(Math.pow(2, task.attempt) * 200 as long);
                  return task.attempt <= 3 ? 'retry' : 'ignore'
                }
            }
            withLabel: cpuTask {
                cpus = 8
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
                queue = 'cpu'
                memory = 1024.GB
            }
        }
    }
}

plugins {
  id 'nf-schema@2.2.0'
}
