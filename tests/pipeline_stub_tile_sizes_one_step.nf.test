nextflow_pipeline {
    name   "Per-model recommended tile sizes (one-step) — stub mode"
    script "../main.nf"
    profile "test_stub_tile_sizes_one_step"
    options "-stub"

    // Same models through the one-step workflow.
    test("one-step: each model gets its own tile set") {
        when {
            params { outdir = "${outputDir}" }
        }
        then {
            assert workflow.success
            // Tile size recorded in a patch.h5 (the stubs write it like real tessellation does).
            def tileSize = { String h5 ->
                def proc = ["python3", "-c", "import h5py,sys; print(int(h5py.File(sys.argv[1], 'r')['coords'].attrs['patch_size_to_resize_to_for_desired_mpp']))", h5].execute()
                proc.waitFor()
                assert proc.exitValue() == 0 : "reading ${h5} failed:\n${proc.err.text}"
                proc.text.trim() as Integer
            }
            assert tileSize("${outputDir}/tiles/948176.patch.h5") == 224
            assert tileSize("${outputDir}/tiles_512px/948176.patch.h5") == 512
        }
    }
}
