nextflow.enable.moduleBinaries = true

// process.conda = "${projectDir}/mussel_env.yaml"
process.conda = "/gpfs/mskmind_ess/limr/repos/Mussel/venv"

env.PYTHONPATH = "${projectDir}/lib"


validation {
  help {
    enabled = true
  }
}

params {
  // Workflow mode selection
  use_one_step_workflow = true  // Set to true to use TESSELLATE_FEATURIZE_BATCH (one-step), false for separate TESSELLATE + FEATURIZE_BATCH (two-step)

  tiling {
    // ============================================================================
    // LEGACY TILE FILTERING (classifier-based, post-tessellation)
    // ============================================================================
    // When filter_tiles = true, an extra step runs after tessellation:
    //   1. Extract features for each tile using filter_model_type
    //   2. Apply a .pkl classifier at filter_threshold to keep only tissue tiles
    //   3. The filtered tile set is then used for main feature extraction
    // This requires a pre-trained sklearn classifier .pkl file (filter_model_path).
    filter_model_type = 'ctranspath'
    filter_model_path = "/gpfs/mskmind_ess/limr/repos/Mussel/model-1727990346535.pkl"
    filter_threshold = 0.75
    filter_tiles = false

    // ============================================================================
    // SEGMENTATION / TESSELLATION OPTIONS
    // ============================================================================
    // Segmentation config group: 'default', 'biopsy', 'resection', or 'tcga'
    // See mussel/cli/tessellate.py for preset configurations
    // If null, uses individual parameters below
    seg_config_group = 'biopsy'  // e.g., 'biopsy', 'resection', 'tcga'

    // Individual segmentation parameters (override group defaults when set)
    patch_size = 224
    mpp = 0.5
    // segment_threshold = 15
    // median_blur_ksize = 11
    // morphology_ex_kernel = 2
    // tissue_area_threshold = 1
    // hole_area_threshold = 1
    // max_num_holes = 2

    save_slide_thumbnail = false
    save_tile_png = false
    stitch_tiles = false

    // ============================================================================
    // SEGMENTATION-INTEGRATED ARTIFACT FILTERING (Requires Mussel v1.2.0+)
    // ============================================================================
    // These options remove artifacts during tessellation itself (not post-hoc).
    // Unlike legacy tile filtering, no separate classifier model is needed.
    //
    //   remove_artifacts:         runs GrandQC in aggressive mode — removes blood,
    //                             necrosis, folds, pen marks and background.
    //                             May over-remove in CNS / sarcoma slides.
    //   remove_penmarks:          removes only pen marks and background (conservative).
    //                             Recommended default.
    //   artifact_exclude_classes: optional list of GrandQC class indices to remove,
    //                             overrides the remove_artifacts/remove_penmarks presets.
    //                             Class IDs: 0=glass 1=normal 2=blood 3=necrosis
    //                                        4=pen_mark 5=fold 6=hole 7=background
    //                             Presets:
    //                               conservative  [4, 7]        (pen marks + background)
    //                               moderate      [4, 5, 6, 7]  (+ folds and holes)
    //                               aggressive    [2,3,4,5,6,7] (all non-normal tissue)
    //   seg_model:                'classic' (HSV + fixed threshold), 'otsu', or 'neural'
    //   overlap:                  patch overlap in pixels (default 0)
    //   min_tissue_proportion:    minimum fraction of a patch that must be tissue
    //   slide_mpp_override:       if set, use this µm/px value instead of slide metadata MPP
    //
    // overlap = 0
    // min_tissue_proportion = 0.0
    remove_artifacts = false
    remove_penmarks = true
    // artifact_exclude_classes = [4, 7]   // uncomment for explicit control
    seg_model = 'neural'
    // slide_mpp_override = null
  }

  featurize {
    // Supported model types (patch-level and slide-level encoders):
    // Patch encoders: 'resnet50', 'ctranspath', 'gigapath', 'virchow', 'virchow2',
    //                 'optimus', 'hoptimus1', 'h0mini', 'uni', 'uni2h', 'conch1_5',
    //                 'conch_v1', 'clip', 'googlepath', 'phikon', 'phikon_v2',
    //                 'midnight12k', 'gpfm', 'hibou_l', 'openmidnight', 'genbio_pathfm',
    //                 'kaiko_vits8', 'kaiko_vits16', 'kaiko_vitb8', 'kaiko_vitb16',
    //                 'kaiko_vitl14', 'lunit_vits8', 'lunit_vits16'
    // Slide encoders: 'gigapath_slide', 'titan_slide', 'prism_slide',
    //                 'feather_slide', 'chief_slide', 'madeleine_slide',
    //                 'abmil_slide' (encoder-agnostic; specify patch encoder separately)
    //
    // Note: Slide encoders can be specified directly in model_types.
    // The pipeline will automatically infer and use the required patch encoder.
    // For example, specifying 'gigapath_slide' will automatically use 'gigapath'
    // for patch encoding and then aggregate with 'gigapath_slide'.
    // Both patch and slide features will be saved separately.
    model_types = ['hoptimus1', 'titan_slide']

    use_gpu = true
    save_features_to_h5 = true

    // ============================================================================
    // PRECISION CONFIGURATION
    // ============================================================================
    // Controls the numeric dtype used when saving extracted feature embeddings.
    // "float32" (default) preserves full precision.
    // "float16" halves storage size with minor precision loss.
    // "bfloat16" uses brain-float format (same exponent range as float32).
    //
    // Note: Multi-slide sample aggregation (MERGE_SAMPLE_FEATURES) with
    // non-float32 precision is currently unsupported.
    //
    embedding_precision = "float32"

    // Optional per-model overrides (takes precedence over embedding_precision).
    // Uncomment and set as needed:
    // model_precision_overrides {
    //     optimus  = "float16"
    //     virchow2 = "bfloat16"
    // }

    // Precision variants for linear probe benchmarking.
    // When set, a CPU-only conversion step casts existing float32 features to
    // each listed precision and feeds all variants into the linear probe workflow
    // for side-by-side comparison. Designed for use with embedding_precision="float32".
    benchmark_precisions = null
    // benchmark_precisions = ["float16", "bfloat16"]

    // There are three types of batching that occur during feature extraction:
    //
    // 1. TILE BATCHING (batch_size):
    //    Number of tiles processed together by the patch/tile encoder in a single forward pass.
    //    This is the batch size for the patch-level model (e.g., gigapath, optimus, ctranspath).
    //    Higher values = faster processing but more GPU memory usage.
    //    Default: 64
    //
    // 2. WORKFLOW BATCHING (workflow_batch_size):
    //    Number of SLIDES grouped together in a single Nextflow task for processing.
    //    All tiles from these slides are extracted in one job. This reduces Nextflow
    //    scheduling overhead and allows efficient parallel processing.
    //    Default: 8
    //
    // 3. SLIDE ENCODER BATCHING (slide_batch_size):
    //    When using slide-level models (e.g., gigapath_slide, titan_slide), this determines
    //    how many slide-level feature aggregations are computed together in a single batch.
    //    Only used when model_types includes slide encoders.
    //    Default: 8
    //
    // Recommended settings:
    // - Small GPU (16GB): batch_size=32, workflow_batch_size=4, slide_batch_size=4
    // - Medium GPU (24GB): batch_size=64, workflow_batch_size=8, slide_batch_size=8
    // - Large GPU (40GB+): batch_size=128, workflow_batch_size=16, slide_batch_size=16
    //
    batch_size = 64              // Tile batching: number of tiles per forward pass
    workflow_batch_size = 8      // Workflow batching: number of slides per Nextflow task
    slide_batch_size = 8         // Slide encoder batching: number of slides aggregated together
    slide_max_patches = null     // Max patches per slide for slide-level models (null = no limit).
                                 // Slides exceeding this are subsampled to prevent CUDA OOM in
                                 // models with O(N²) attention (e.g., TITAN_SLIDE).
                                 // Recommended: 4096 for V100 (16 GB), 8192 for A100 (40 GB).
    max_tiles_per_sample = null  // Multi-slide: max tiles to sample per sample (null = no limit)
    subsampling_strategy = "random"  // Multi-slide: tile subsampling strategy — "random", "proportional", or "equal"
    subsampling_seed     = 42        // Multi-slide: random seed for subsampling reproducibility

    // Optional: Specify local paths for models (default: download from HuggingFace Hub)
    // Only needed if you want to use locally cached models instead of downloading
    // Uncomment the block and add paths as needed:
    // model_paths {
    //     ctranspath = "/gpfs/mskmind_ess/limr/repos/TransPath/ctranspath.pth"
    //     optimus = "/gpfs/mskmind_ess/limr/repos/mussel-nf/optimus.pkl"
    //     resnet50 = "/gpfs/mskmind_ess/limr/repos/Mussel/resnet50.pkl"
    //     gigapath = "/gpfs/cdsi_ess/kohlia/codebase/models/gigapath_model.pkl"
    // }

    // Optional: Configure per-model batch sizes
    // If not specified, uses the default batch_size above
    // model_batch_sizes {
    //     ctranspath = 32
    //     optimus = 64
    //     virchow2 = 256
    // }

    // Optional: Specify local paths for slide-level models
    // Only needed if you want to use locally cached slide models
    // slide_model_paths {
    //     gigapath_slide = "/path/to/gigapath_slide_model"
    //     titan_slide = "/path/to/titan_slide_model"
    // }

    // Mapping from slide encoders to their required patch encoders
    // This is automatically applied when using slide encoders in model_types
    // See mussel/models/model_factory.py SLIDE_ENCODER_COMPATIBILITY for the source
    slide_to_patch_mapping {
        gigapath_slide    = 'gigapath'
        titan_slide       = 'conch1_5'
        prism_slide       = 'virchow'
        feather_slide     = 'conch1_5'
        chief_slide       = 'ctranspath'
        madeleine_slide   = 'clip'
    }
  }

  clip {
    model_types = ['quiltnet']
    default_classes = ["invasive carcinoma", "stroma", "other"]
    oncotree_class_csv = null
    skip_tile_caching = true
  }

  // ============================================================================
  linear_probe {
    annotation_class_mapping_yaml = null
    annotations_csv = null
    cv = 5
    C_values = [0.00001, 0.0001, 0.001, 0.01, 0.1, 1.0, 10.0]
    penalties = ["l2"]
    n_seeds = 5
    n_bootstrap = 1000
    random_state = 42
    // When annotation_class_mapping_yaml is used, annotations are remapped to 0/1;
    // set positive_annotation_label=1 so the benchmark treats 1 as the positive class.
    positive_annotation_label = 1
    // Set multiclass=true when using a class_mapping that emits ≥ 3 distinct non-zero
    // labels (e.g., class_mapping_multiclass.yaml). Background (annotation==0) tiles are
    // excluded automatically. OvR macro AUC-ROC and macro F1 are reported.
    multiclass = false
  }

  // ============================================================================
  // ABMIL BENCHMARK
  // ============================================================================
  // When labels_parquet and target_col are set, trains a Gated-ABMIL classifier on
  // per-slide H5 feature files and reports AUROC across multiple seeds.
  // This runs automatically alongside (or instead of) featurisation whenever these
  // params are populated; it also participates in precision benchmarking when
  // featurize.benchmark_precisions is set.
  abmil_benchmark {
    labels_parquet = null      // path to parquet: slide_id, <target_col>, [split_col]
    target_col     = null      // binary label column (integer 0/1)
    split_col      = null      // optional column with 'train'/'val'/'test' values
    n_seeds        = 3
    n_bootstrap    = 1000
    random_state   = 42
    n_epochs       = 20
    batch_size     = 8
    lr             = 1e-4
    head_dim       = 256
    n_heads        = 8
    dtype          = "float32" // cast features to this dtype at load time; use float16/bfloat16 to simulate low-precision storage
    test_size      = 0.2
    val_size       = 0.1
  }

  workflow_id = "reef"

  outdir = "results"
  publish_mode = "copy"
  samples_csv = null

  samples_csv_watch_path = null
  watch_path = null

  // Path to slide files for tests that build their channel directly (no CSV).
  // Set by the test_multi_slide profile; ignored in normal runs.
  test_data_dir = null

  publish_slide_prefix = true

  scratch_dir = null

  // ============================================================================
  // WEBDATASET SHARDING
  // ============================================================================
  // When wds.enabled = true, completed per-slide .pt (and optionally .h5)
  // feature files are packed into paladin-compatible WebDataset tar shards.
  // Each tar entry contains {slide_id}.features.npy (float32) and optionally
  // {slide_id}.coords.npy (int64 tile coordinates from the .h5 file).
  //
  // wds.enabled          : enable WDS shard output (default: false)
  // wds.group_by_oncotree: when true, create separate shard sets per oncotree_code
  //                        (requires oncotree_code column in samples_csv);
  //                        when false, all slides share a single "all" group
  // wds.shard_h5         : extract tile coords from .h5 and store as .coords.npy
  //                        (default: false — .h5 files are large)
  // wds.max_shard_size   : max number of slides per .tar shard (default: 1000)
  // wds.shard_prefix     : filename prefix for shards (default: "" → 000000.tar)
  //
  // Output layout:
  //   results/wds/{model_type}/all/000000.tar          (group_by_oncotree=false)
  //   results/wds/{model_type}/{oncotree_code}/*.tar   (group_by_oncotree=true)
  wds {
    enabled           = false
    group_by_oncotree = false
    shard_h5          = false
    max_shard_size    = 1000
    shard_prefix      = ""
  }

  // ============================================================================
  // S3/ECS SLIDE PRE-FETCH (PREFETCH_SLIDE process)
  // ============================================================================
  // When slide_path is an S3 URI, PREFETCH_SLIDE downloads it to a local
  // storeDir cache on a CPU cluster node BEFORE the GPU job runs.  This
  // prevents the GPU node from wasting time on downloads and allows downloads
  // to overlap with GPU compute across batches.
  //
  // prefetch.enabled       : pre-fetch S3 slides before GPU tasks (default: true)
  // prefetch.local_dir     : root cache dir for pre-fetched slides
  // prefetch.s3_endpoint   : custom S3/ECS endpoint URL (default: null = AWS)
  // prefetch.max_concurrent: max parallel downloads (maxForks, default: 16)
  prefetch {
    enabled        = true
    local_dir      = "s3-slides"
    s3_endpoint    = null
    max_concurrent = 16
  }

  // ============================================================================
  // GDC SLIDE DOWNLOAD (DOWNLOAD_SLIDE process)
  // ============================================================================
  // Used when samples_csv contains rows with needs_download=true (slides not yet
  // on disk or S3).  DOWNLOAD_SLIDE fetches each file via gdc-client and caches
  // it under local_dir/<file_id>/<file_name> using Nextflow's storeDir.
  //
  // download.local_dir      : root directory for downloaded slides (default: tcga-slides)
  // download.gdc_token_file : path to GDC user token for controlled-access data (optional)
  // download.n_connections  : parallel connections per gdc-client invocation (default: 8)
  download {
    local_dir       = "tcga-slides"
    gdc_client_bin  = "gdc-client"
    gdc_token_file  = ""
    n_connections   = 8
    max_concurrent  = 16   // max parallel DOWNLOAD_SLIDE tasks per batch (maxForks)
    jitter_seconds  = 30   // random sleep 0–N seconds before gdc-client to avoid simultaneous API calls
  }
}

aws {
    accessKey = secrets.ECS_ACCESS_KEY
    secretKey = secrets.ECS_SECRET_KEY
    client {
      maxConnections = 8
        endpoint = "http://pmindecs.mskcc.org:9020"
        s3PathStyleAccess = true
    }
}

azure {
    storage {
        accountName = "mskpdm"
        accountKey = secrets.AZURE_STORAGE_KEY
    }
    batch {
        location = 'eastus2'
        accountName = 'ocra'
        accountKey = secrets.AZURE_BATCH_KEY
        autoPoolMode = false
        allowPoolCreation = true
        deletePoolsOnCompletion = true
        pools {
            'gpu_v100' {
                autoScale = true
                vmType = 'Standard_NC6s_v3'
                offer = 'ubuntu-hpc'
                publisher = 'microsoft-dsvm'
                sku = "batch.node.ubuntu 22.04"
                vmCount = 5
                maxVmCount = 30
            }
            'cpu' {
                autoScale = true
                vmType = 'Standard_E8_v3'
                vmCount = 5
                maxVmCount = 50
            }
        }
    }
}
profiles {
    standard {
        process {
            executor = 'local'
            memory = 36.GB

            withLabel: parallelTask {
                cpus = 8
            }
            withLabel: downloadTask {
                memory = 4.GB
                cpus   = 4
                errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
                maxRetries    = 3
            }
        }
    }

    docker {
        docker.enabled = true
        params {
            tiling.filter_model_path = "/code/mussel/model-1727990346535.pkl"
        }
        process {
            container = "mskmind/mussel:current"
            containerOptions = "--user root"
        }
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        env.TORCH_HOME = "torch"
        process {
            container = "docker://mskmind/mussel:current"
            // container = '/gpfs/mskmind_ess/limr/repos/Mussel/mussel-current.sif'
            containerOptions = "--env PREPEND_PATH=/opt/conda/bin"
        }
    }

    conda {
        conda.enabled = true
        process {
            withLabel: downloadTask {
                conda = "${projectDir}/gdc_env.yaml"
            }
        }
    }

    cluster {
    executor {
      queueSize = 500
    }
      process {
        errorStrategy = 'ignore'
        maxErrors = -1
        // errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
            withLabel: smallTask {
                memory = 12.GB
            }

            withLabel: bigTask {
                memory        = { 80.GB * task.attempt }
                errorStrategy = { task.exitStatus == 137 && task.attempt <= 2 ? 'retry' : 'ignore' }
                maxRetries    = 2
            }

            withLabel: hugeTask {
                memory = 1024.GB
            }

            withLabel: parallelTask {
                cpus = 8
            }

            withLabel: localTask {
                executor = 'local'
            }

            withLabel: downloadTask {
                memory        = 4.GB
                cpus          = 4
                time          = '6h'
                errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
                maxRetries    = 3
            }

        }
    }

    condor {
        process {
            executor = 'condor'

            withLabel: gpuTask {
                clusterOptions = "request_gpus=1"
            }

            // Neural segmentation (seg_model='neural', the default) requires a GPU.
            // Route TESSELLATE to GPU nodes when neural, CPU nodes otherwise.
            withName: TESSELLATE {
                clusterOptions = { params.tiling.seg_model == 'neural' ? 'request_gpus=1' : '' }
            }

        }
    }

    slurm {
        process {
            executor = 'slurm'
            withLabel: gpuTask {
                // Exclude P40 nodes (pllimsksparky*) — they are ~10-15x slower than A100/V100
                // and cause GPU tasks to run 4-12 hours instead of ~45 minutes.
                // Time limit: normal batches finish in ~45 min; 4h covers the largest slides (38k+ tiles).
                clusterOptions = "--gpus=1 --exclude=pllimsksparky1,pllimsksparky2,pllimsksparky3,pllimsksparky4 --time=4:00:00"
                // Retry on node failure / external termination (tllihpcgpu[3,4] are flaky).
                // SLURM resubmits the new job to any available GPU node, bypassing failed hardware.
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
                maxRetries    = 2
            }

            // Neural segmentation (seg_model='neural', the default) requires a GPU.
            // Route TESSELLATE to GPU nodes when neural, CPU nodes otherwise.
            // Tiling is much faster than featurization so a shorter time limit is fine.
            withName: TESSELLATE {
                clusterOptions = {
                    params.tiling.seg_model == 'neural'
                        ? '--gpus=1 --time=1:00:00'
                        : ''
                }
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
                maxRetries    = 2
            }

        }
    }


    test {
        params {
            samples_csv = "${projectDir}/tests/test.csv"
            outdir      = "${projectDir}/tests/results"

            use_one_step_workflow = true

            tiling {
                filter_tiles      = false
                seg_config_group  = 'biopsy'
                patch_size        = 224
                mpp               = 0.5
            }

            featurize {
                model_types        = ['resnet50']
                use_gpu            = true
                save_features_to_h5 = true
                batch_size         = 64
                workflow_batch_size = 1
                slide_batch_size   = 1
            }

            clip {
                model_types = []
            }

            linear_probe {
                annotations_csv = null
            }
        }

        process {
            executor = 'local'
            beforeScript = "export PATH=${System.getenv('MUSSEL_VENV') ?: '/gpfs/mskmind_ess/limr/repos/Mussel/venv'}/bin:\$PATH"

            withLabel: parallelTask {
                cpus = 4
            }
            withLabel: bigTask {
                memory = 30.GB
            }
        }
    }

    test_two_step {
        params {
            samples_csv = "${projectDir}/tests/test.csv"
            outdir      = "${projectDir}/tests/results_two_step"

            use_one_step_workflow = false

            tiling {
                filter_tiles      = false
                seg_config_group  = 'biopsy'
                patch_size        = 224
                mpp               = 0.5
            }

            featurize {
                model_types        = ['resnet50']
                use_gpu            = true
                save_features_to_h5 = true
                batch_size         = 64
                workflow_batch_size = 1
                slide_batch_size   = 1
            }

            clip {
                model_types = []
            }

            linear_probe {
                annotations_csv = null
            }
        }

        process {
            executor = 'local'
            beforeScript = "export PATH=${System.getenv('MUSSEL_VENV') ?: '/gpfs/mskmind_ess/limr/repos/Mussel/venv'}/bin:\$PATH"

            withLabel: parallelTask {
                cpus = 4
            }
            withLabel: bigTask {
                memory = 30.GB
            }
        }
    }

    test_wds {
        params {
            samples_csv = "${projectDir}/tests/test.csv"
            outdir      = "${projectDir}/tests/results_wds"

            use_one_step_workflow = true

            tiling {
                filter_tiles      = false
                seg_config_group  = 'biopsy'
                patch_size        = 224
                mpp               = 0.5
            }

            featurize {
                model_types         = ['resnet50']
                use_gpu             = true
                save_features_to_h5 = true
                batch_size          = 64
                workflow_batch_size = 1
                slide_batch_size    = 1
            }

            clip {
                model_types = []
            }

            linear_probe {
                annotations_csv = null
            }

            wds {
                enabled           = true
                group_by_oncotree = false
                shard_h5          = false
                max_shard_size    = 1000
                shard_prefix      = "shard-"
            }
        }

        process {
            executor = 'local'
            beforeScript = "export PATH=${System.getenv('MUSSEL_VENV') ?: '/gpfs/mskmind_ess/limr/repos/Mussel/venv'}/bin:\$PATH"

            withLabel: parallelTask {
                cpus = 4
            }
            withLabel: bigTask {
                memory = 30.GB
            }
        }
    }

    test_wds_grouped {
        params {
            samples_csv = "${projectDir}/tests/test_oncotree.csv"
            outdir      = "${projectDir}/tests/results_wds_grouped"

            use_one_step_workflow = true

            tiling {
                filter_tiles      = false
                seg_config_group  = 'biopsy'
                patch_size        = 224
                mpp               = 0.5
            }

            featurize {
                model_types         = ['resnet50']
                use_gpu             = true
                save_features_to_h5 = true
                batch_size          = 64
                workflow_batch_size = 1
                slide_batch_size    = 1
            }

            clip {
                model_types = []
            }

            linear_probe {
                annotations_csv = null
            }

            wds {
                enabled           = true
                group_by_oncotree = true
                shard_h5          = false
                max_shard_size    = 1000
                shard_prefix      = "shard-"
            }
        }

        process {
            executor = 'local'
            beforeScript = "export PATH=${System.getenv('MUSSEL_VENV') ?: '/gpfs/mskmind_ess/limr/repos/Mussel/venv'}/bin:\$PATH"

            withLabel: parallelTask {
                cpus = 4
            }
            withLabel: bigTask {
                memory = 30.GB
            }
        }
    }

    test_abmil_benchmark {
        // Exercises ABMIL_BENCHMARK / SUMMARIZE_ABMIL_BENCHMARK using pre-generated
        // synthetic fixtures in tests/fixtures/abmil_benchmark/.
        // No GPU or real slides required — runs entirely on the local executor.

        // Override env.PYTHONPATH: the global setting uses ${projectDir}/lib but
        // for tests/ entry-points projectDir=tests/ so lib/ is not found.
        // Use Groovy to compute the parent of projectDir (the repo root) at parse time.
        env.PYTHONPATH = new File(projectDir.toString()).parentFile.absolutePath + "/lib"

        params {
            outdir = "${projectDir}/tests/results_abmil_benchmark"

            abmil_benchmark {
                labels_parquet = "${launchDir}/tests/fixtures/abmil_benchmark/labels.parquet"
                target_col     = "label"
                // Speed-optimised for CI
                n_seeds        = 1
                n_bootstrap    = 10
                random_state   = 42
                n_epochs       = 2
                batch_size     = 4
                head_dim       = 8
                n_heads        = 1
            }
        }

        process {
            executor = 'local'
            beforeScript = "export PATH=${System.getenv('MUSSEL_VENV') ?: '/gpfs/mskmind_ess/limr/repos/Mussel/venv'}/bin:\$PATH"

            withLabel: parallelTask { cpus   = 4 }
            withLabel: bigTask      { memory = 6.GB }
            withLabel: hugeTask     { memory = 6.GB }
        }
    }

    test_linear_probe {
        // Exercises the LINEAR_PROBE workflow using pre-generated synthetic fixtures.

        // Override env.PYTHONPATH: the global setting uses ${projectDir}/lib but
        // for tests/ entry-points projectDir=tests/ so lib/ is not found.
        // Use Groovy to compute the parent of projectDir (the repo root) at parse time.
        env.PYTHONPATH = new File(projectDir.toString()).parentFile.absolutePath + "/lib"

        params {
            outdir = "${projectDir}/tests/results_linear_probe"

            linear_probe {
                annotation_class_mapping_yaml = "${launchDir}/tests/fixtures/linear_probe/class_mapping.yaml"
                annotations_csv               = null   // channels built directly in linear_probe.nf

                // Speed-optimised for CI: single seed, minimal grid search, few bootstraps
                cv                        = 2
                C_values                  = [1.0]
                penalties                 = ["l2"]
                n_seeds                   = 1
                n_bootstrap               = 10
                positive_annotation_label = 1
                // seed=1 ensures val split has both annotation classes (seed=42 gives all-negative val)
                random_state              = 1
            }
        }

        process {
            executor = 'local'
            beforeScript = "export PATH=${System.getenv('MUSSEL_VENV') ?: '/gpfs/mskmind_ess/limr/repos/Mussel/venv'}/bin:\$PATH"

            withLabel: parallelTask {
                cpus = 4
            }
            withLabel: bigTask {
                memory = 6.GB
            }
            withLabel: hugeTask {
                memory = 6.GB
            }
        }
    }

    test_multi_slide {
        params {
            test_data_dir = "${projectDir}/data"
            outdir        = "${projectDir}/tests/results_multi_slide"

            use_one_step_workflow = true

            tiling {
                filter_tiles      = false
                seg_config_group  = 'biopsy'
                patch_size        = 224
                mpp               = 0.5
            }

            featurize {
                model_types         = ['resnet50']
                use_gpu             = true
                save_features_to_h5 = true
                batch_size          = 64
                workflow_batch_size = 1
                slide_batch_size    = 1
            }

            clip {
                model_types = []
            }

            linear_probe {
                annotations_csv = null
            }
        }

        process {
            executor = 'local'
            beforeScript = "export PATH=${System.getenv('MUSSEL_VENV') ?: '/gpfs/mskmind_ess/limr/repos/Mussel/venv'}/bin:\$PATH"

            withLabel: parallelTask {
                cpus = 4
            }
            withLabel: bigTask {
                memory = 30.GB
            }
        }
    }

    // Stub test profile: exercises the full one-step workflow using Nextflow's
    // -stub mode. All GPU processes use their stub: blocks to produce minimal
    // fake output files. No mussel CLI, no real model weights, no GPU needed.
    // Only requires: torch (CPU), h5py, numpy in PATH.
    test_stub {
        includeConfig 'conf/test_stub_base.config'
        params {
            outdir = "${projectDir}/tests/results_stub"
        }
    }

    test_stub_two_step {
        includeConfig 'conf/test_stub_base.config'
        params {
            outdir                = "${projectDir}/tests/results_stub_two_step"
            use_one_step_workflow = false
        }
    }

    test_stub_filter {
        includeConfig 'conf/test_stub_base.config'
        params {
            outdir                = "${projectDir}/tests/results_stub_filter"
            use_one_step_workflow = false  // filter_tiles only works in the two-step workflow
            tiling {
                filter_tiles      = true
                filter_model_type = 'ctranspath'
                filter_model_path = 'stub.pkl'
                filter_threshold  = 0.5
            }
        }
    }

    test_stub_wds {
        includeConfig 'conf/test_stub_base.config'
        params {
            outdir = "${projectDir}/tests/results_stub_wds"
            wds {
                enabled           = true
                group_by_oncotree = false
                shard_h5          = false
                max_shard_size    = 1000
                shard_prefix      = ""
            }
        }
    }

    test_stub_wds_grouped {
        includeConfig 'conf/test_stub_base.config'
        params {
            samples_csv = "${projectDir}/tests/test_oncotree.csv"
            outdir      = "${projectDir}/tests/results_stub_wds_grouped"
            wds {
                enabled           = true
                group_by_oncotree = true
                shard_h5          = false
                max_shard_size    = 1000
                shard_prefix      = ""
            }
        }
    }

    test_stub_clip {
        includeConfig 'conf/test_stub_base.config'
        params {
            samples_csv = "${projectDir}/tests/test_oncotree.csv"
            outdir      = "${projectDir}/tests/results_stub_clip"
            featurize {
                model_types = ['clip']
            }
            clip {
                model_types       = ['clip']
                skip_tile_caching = true
                default_classes   = ["Tumor", "Stroma"]
            }
        }
    }

    test_stub_multi_slide {
        includeConfig 'conf/test_stub_base.config'
        params {
            samples_csv = "${projectDir}/tests/test_multi_slide.csv"
            outdir      = "${projectDir}/tests/results_stub_multi_slide"
        }
    }


    test_stub_abmil_benchmark {
        includeConfig 'conf/test_stub_base.config'
        params {
            outdir = "${projectDir}/tests/results_stub_abmil_benchmark"

            abmil_benchmark {
                labels_parquet = "${projectDir}/tests/fixtures/abmil_benchmark/labels.parquet"
                target_col     = "label"
                n_seeds        = 1
                n_epochs       = 2
                batch_size     = 4
                head_dim       = 8
                n_heads        = 1
            }
        }
    }

    test_stub_precision {
        includeConfig 'conf/test_stub_base.config'
        params {
            outdir = "${projectDir}/tests/results_stub_precision"
            featurize {
                benchmark_precisions = ['float16', 'bfloat16']
            }
        }
    }


    cloud {
        process {
            executor = 'azurebatch'
            containerOptions = "--user=root --ipc=host"

            memory = 16.GB

            withLabel: localTask {
                executor = 'local'
            }
            withLabel: gpuTask {
                queue = 'gpu_v100'
                cpus = 6
                memory = 100.GB
                time = '1h'
                errorStrategy = {
                  sleep(Math.pow(2, task.attempt) * 200 as long);
                  return task.attempt <= 3 ? 'retry' : 'ignore'
                }
            }
            withLabel: cpuTask {
                cpus = 8
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
                queue = 'cpu'
                memory = 1024.GB
            }

            // Neural segmentation requires GPU. Route to gpu_v100 when neural,
            // cpu queue otherwise (mirrors cpuTask vs gpuTask routing above).
            withName: TESSELLATE {
                queue  = { params.tiling.seg_model == 'neural' ? 'gpu_v100' : 'cpu' }
                cpus   = { params.tiling.seg_model == 'neural' ? 6 : 8 }
                memory = { params.tiling.seg_model == 'neural' ? 100.GB : 1024.GB }
                time   = '1h'
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
            }
        }
    }
}

plugins {
  id 'nf-schema@2.7.2'
}
