nextflow_pipeline {
    name   "FEATURIZE_BATCH real script — Mussel 1.6.0 partial batch, slide encoder"
    script "../tests/featurize_batch_partial_script.nf"
    profile "test_real_featurize_slide"

    test("slide encoder: an empty patch_features.h5 is not emitted") {
        when {
            params {
                outdir = "${outputDir}"
                model  = 'titan_slide'
            }
        }
        then {
            assert workflow.success
            def published = new File("${outputDir}/features/conch1_5").list().toList().sort()
            assert published == ['1001234.patch_features.h5', 'SLIDE0002.patch_features.h5']
            assert new File("${outputDir}/features/titan_slide").list().toList().sort() ==
                ['1001234.features.h5', '1001234.features.pt', 'SLIDE0002.features.h5', 'SLIDE0002.features.pt']
            def failed = path("${outputDir}/failed_slides.tsv").readLines().drop(1).sort()
            assert failed == ['EMPTY0003\ttitan_slide\tno_tiles', 'FAIL0001\ttitan_slide\tfailed']
        }
    }
}
