nextflow.enable.moduleBinaries = true

process.conda = "/gpfs/mskmind_ess/limr/repos/Mussel/venv"
// process.conda = "mussel_env.yaml"

params.filter_model_path = "/gpfs/mskmind_ess/limr/repos/Mussel/model-1727990346535.pkl"


params {
  model_types = ['optimus']
  filter_model_type = 'ctranspath'
  filter_tiles = true
  // clip_default_classes = ["invasive carcinoma", "stroma", "other"]

    dremio {
        hostname = 'tlvidreamcord1'
        port = 32010
        scheme = 'grpc+tcp'
        space = 'OCRA.archive'
        table = 'matched_QC_case_breakdown'
    }
}

aws {
    accessKey = secrets.LARGE_ACCESS_KEY
    secretKey = secrets.LARGE_SECRET_KEY
    client {
      maxConnections = 20
        endpoint = "https://pllimsksparky3:9006"
        s3PathStyleAccess = true
    }
}

azure {
    storage {
        accountName = "mskpdm"
        accountKey = secrets.AZURE_STORAGE_KEY
    }
    batch {
        location = 'eastus2'
        accountName = 'ocra'
        accountKey = secrets.AZURE_BATCH_KEY
        autoPoolMode = false
        allowPoolCreation = true
        deletePoolsOnCompletion = true
        pools {
            'gpu_v100' {
                autoScale = true
                vmType = 'Standard_NC6s_v3'
                offer = 'ubuntu-hpc'
                publisher = 'microsoft-dsvm'
                sku = "batch.node.ubuntu 22.04"
                vmCount = 5
                maxVmCount = 30
            }
            'cpu' {
                autoScale = true
                vmType = 'Standard_E8_v3'
                vmCount = 5
                maxVmCount = 50
            }
        }
    }
}
profiles {
    standard {
        memory = 36.GB

        process {
            executor = 'local'

            withLabel: parallelTask {
                cpus = 8
            }
        }
    }

    docker {
        docker.enabled = true
        process {
            container = "mskmind/mussel:current"
            containerOptions = "--user root"
        }
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        env.TORCH_HOME = "torch"
        process {
            container = "docker://mskmind/mussel:current"
            // container = '/gpfs/mskmind_ess/limr/repos/Mussel/mussel-current.sif'
            containerOptions = "--env PREPEND_PATH=/opt/conda/bin"
        }
    }

    conda {
        conda.enabled = true
    }

    cluster {
    executor {
      queueSize = 500
    }
      process {
        errorStrategy = 'ignore'
        // errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
            withLabel: smallTask {
                memory = 12.GB
            }

            withLabel: bigTask {
                memory = 30.GB
            }

            withLabel: hugeTask {
                memory = 1024.GB
            }

            withLabel: parallelTask {
                cpus = 8
            }

            withLabel: localTask {
                executor = 'local'
            }

        }
    }

    condor {
        process {
            executor = 'condor'

            withLabel: gpuTask {
                clusterOptions = "request_gpus=1"
            }

        }
    }

    slurm {
        process {
            executor = 'slurm'
            withLabel: gpuTask {
                clusterOptions = "--gpus=1"
            }

        }
    }


    cloud {
      params {
        ctranspath.model_path = "/code/mussel/ctranspath.pth"
        filter_model_path = "/code/mussel/model-1727990346535.pkl"
      }
        process {
            executor = 'azurebatch'
            containerOptions = "--user=root --ipc=host"

            memory = 16.GB

            withLabel: localTask {
                executor = 'local'
            }
            withLabel: gpuTask {
                queue = 'gpu_v100'
                cpus = 6
                memory = 100.GB
                time = '1h'
                errorStrategy = {
                  sleep(Math.pow(2, task.attempt) * 200 as long);
                  return task.attempt <= 3 ? 'retry' : 'ignore'
                }
            }
            withLabel: cpuTask {
                cpus = 8
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
                queue = 'cpu'
                memory = 1024.GB
            }
        }
    }
}
