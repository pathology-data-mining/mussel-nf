nextflow_pipeline {
    name   "MUSSEL two-step pipeline — stub mode"
    script "../main.nf"
    profile "test_stub_two_step"
    options "-stub"

    test("two-step stub workflow succeeds and publishes feature files") {
        when {
            params { outdir = "${outputDir}" }
        }
        then {
            assert workflow.success
            assert path("${outputDir}/features/resnet50/948176.features.pt").exists()
            assert path("${outputDir}/features/resnet50/948176.features.h5").exists()
            assert path("${outputDir}/tiles/9481/948176.patch.h5").exists()
        }
    }
}
